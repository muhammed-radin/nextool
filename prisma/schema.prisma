generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ NexTool Q1 v1.0.0 ============

model Task {
  id             String     @id
  name           String?
  request        String
  goal           String?
  mode           String     // goal | live
  reasoningLevel Int        @default(4)
  status         String     // queued | running | waiting | completed | failed | stopped | cancelled
  statusDetail   String?
  // v1.0.12 Phase 7 — user-provided custom task instructions (textarea +
  // uploaded Markdown COMBINED at creation). Instruction CONTEXT ONLY — it is
  // never executed as code; it is injected into planner/core/observer prompts
  // BELOW the fixed system constraints. Null when the task has none.
  instructions   String?
  config         String     @default("{}") // JSON TaskConfig
  state          String     @default("{}") // JSON MainStateModel (serializable)
  plan           String?    // JSON PlanStep[]
  finalResult    String?    // JSON structured final result
  error          String?    // JSON { code, message, stage }
  steps          Int        @default(0)
  toolCalls      Int        @default(0)
  durationMs     Int?
  sessionId      String?
  createdAt      DateTime   @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime   @updatedAt
  events         TaskEvent[]
  history        HistoryEntry[]
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      String   // task.created, planner.*, core.*, tool.*, observer.*, state.*, subgoal.*, goal.*, env.*, user.*, error.*
  source    String   // runtime | planner | observer | core | tool | environment | user | system
  message   String
  data      String? // JSON payload
  priority  Int      @default(5) // 1 = emergency .. 9 = tick
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([type])
}

model ToolRecord {
  name          String   @id
  description   String
  purpose       String?
  category      String   @default("general")
  environment   String   @default("builtin") // builtin | virtual-env | dynamic | js-function
  definition    String // JSON full ToolDefinition (schema etc.)
  handlerKind   String? // dynamic handler: echo | delay | http_get | time | uuid
  handlerConfig String? // JSON
  functionSource String? // v1.0.2: JavaScript source for environment=js-function tools
  toolVersion   String? // v1.0.2: user-facing tool version string (semver-ish, free form)
  enabled       Boolean  @default(true)
  callCount     Int      @default(0)
  successCount  Int      @default(0)
  failureCount  Int      @default(0)
  timeoutCount  Int      @default(0)
  totalMs       Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============ v1.0.2: Training / Benchmark / Branding ============

model TrainingJobRecord {
  id           String   @id @default(cuid())
  datasetId    String
  datasetName  String
  datasetVersion String
  status       String   @default("queued") // queued | starting | running | completed | failed | cancelled
  config       String   @default("{}") // JSON TrainingConfig
  epochs       Int      @default(0)
  epochsDone   Int      @default(0)
  metrics      String   @default("[]") // JSON { at, epoch, loss, valLoss, accuracy, valAccuracy, elapsedMs }[]
  logs         String   @default("[]") // JSON { at, level, message }[]
  finalMetrics String? // JSON { loss, valLoss, accuracy, valAccuracy, trainMs }
  modelRecordId String? // set when a model package was produced
  error        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BenchmarkRunRecord {
  id           String   @id @default(cuid())
  label        String?
  modelKey     String // "llm-core" | "heuristic-fallback" | trained model id
  datasetId    String
  datasetName  String
  datasetVersion String
  config       String   @default("{}") // JSON BenchmarkConfig
  metrics      String   @default("{}") // JSON BenchmarkMetrics
  cases        String   @default("[]") // JSON per-example results (truncated params/results)
  durationMs   Int      @default(0)
  status       String   @default("queued") // queued | running | completed | failed
  error        String?
  createdAt    DateTime @default(now())
}

model MemoryEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String // JSON
  tags      String? // JSON string[]
  source    String   @default("user") // user | runtime | tool
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HistoryEntry {
  id        String   @id @default(cuid())
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  action    String
  params    String? // JSON
  result    String? // JSON
  status    String // completed | failed | timeout | cancelled
  timestamp DateTime @default(now())
  // v1.0.3 — parallel execution provenance (null for sequential calls)
  batchId       String?
  parallelGroup Int?

  @@index([taskId, timestamp])
}

model Setting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

model ModelRecord {
  id         String   @id @default(cuid())
  name       String
  version    String
  format     String // nextool-manifest
  status     String // registered | active | rejected
  manifest   String // JSON
  sizeBytes  Int?
  note       String?
  createdAt  DateTime @default(now())
}

model DatasetRecord {
  id         String   @id @default(cuid())
  name       String
  version    String
  format     String   @default("json") // json | parquet(unavailable)
  trainSize  Int      @default(0)
  valSize    Int      @default(0)
  testSize   Int      @default(0)
  examples   String   @default("[]") // JSON
  categories String? // JSON string[]
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model NotificationRecord {
  id        String   @id @default(cuid())
  title     String
  body      String
  source    String   @default("tool") // tool | runtime | user
  taskId    String?
  level     String   @default("info") // info | warning | critical
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GeneratedImage {
  id        String   @id @default(cuid())
  path      String
  prompt    String
  size      String?
  taskId    String?
  createdAt DateTime @default(now())
}

// ============ v1.0.10: Structured task/observer pattern learning ============

// Structured pattern records extracted from verified Observer observations and
// task outcomes (spec §32-§36). NOT raw logs: each row is a deterministic
// signature (pattern type + conditions + action) with evidence counters.
// Confidence is derived (never stored as an opinion):
//   successRate = successCount / (successCount + failureCount)
//   evidence    = min(1, frequency / 3)          // one event → low confidence
//   confidence  = successRate * evidence - 0.15 * contradictionCount  (min 0)
// A single observation therefore can never become high-confidence knowledge.
model PatternRecord {
  id                 String   @id @default(cuid())
  signature          String   @unique // deterministic pattern identity (type + conditions + action)
  patternType        String // sequence | outcome | verification | failure-recovery | live | early-completion
  inputConditions    String   @default("{}") // JSON: conditions that trigger the pattern
  context            String   @default("{}") // JSON: bounded context metadata (no sensitive payloads)
  actionTool         String // tool the pattern points to
  resultSummary      String   @default("") // bounded human-readable result note
  outcome            String   @default("unknown") // unknown | positive | negative
  confidence         Float    @default(0) // derived evidence score 0..1
  frequency          Int      @default(0) // total observations folded into this signature
  successCount       Int      @default(0)
  failureCount       Int      @default(0)
  contradictionCount Int     @default(0) // contradicting evidence weakens the pattern
  source             String   @default("task-execution")
  taskMode           String   @default("goal")
  plannerType        String   @default("pre-plan")
  sourceRequest      String? // bounded original request for dataset conversion (optional)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============ v1.0.6: Virtual File System (tool workspaces) ============

// Persistent, per-tool isolated storage backing the sandbox `fs` module.
// Files are stored in SQLite (NOT the host filesystem) so tool code can never
// touch NexTool application files. `path` is a normalized absolute VIRTUAL path.
model VirtualFile {
  id        String   @id @default(cuid())
  toolId    String // owning tool = ToolRecord.name
  path      String   @default("/") // normalized absolute virtual path
  kind      String   @default("file") // file | dir
  encoding  String   @default("utf8") // utf8 | base64
  content   String   @default("") // file body (utf8 text or base64)
  size      Int      @default(0) // bytes of file content
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([toolId, path])
  @@index([toolId])
}

// ============ v1.0.12: MCP connectors (NexTool as MCP CLIENT) ============

// A connector = one configured INSTANCE of a supported MCP server platform
// (provider definitions live in config/mcp-servers.json — NOT hard-coded).
// `status` is the REAL connection state (never faked): the manager reconciles
// it against live in-memory clients on every read.
model McpConnector {
  id              String    @id // cuid, prefix "mconn_"
  providerId      String // gmail | google-calendar | google-drive | github | custom | … (from the JSON registry)
  name            String // user-facing connector name (unique)
  config          String    @default("{}") // JSON NON-secret transport config (command/args/url/headers names)
  enabled         Boolean   @default(true)
  // not_connected | connecting | auth_required | connected | disconnected | error | reconnecting
  status          String    @default("not_connected")
  statusDetail    String?
  lastError       String?
  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  credential      McpCredential?

  // ==== v1.0.13 (Task 5) — ADDITIVE OPTIONAL columns (JSON-encoded strings,
  // same pattern as `config`). NULL = legacy v1.0.12 record; every reader
  // must treat null as "derive from provider defaults / legacy config". ====
  // §4.1 connection modes: { mode:'url'|'command', url?, command?, args?:string[], cwd?, env?:Record<string,string> }
  transport       String?
  // §5 auth state (NON-secret parts): { method, oauth?:{ authorizeUrl?, tokenUrl?, scopes? },
  //   authenticatedAt?, tokenExpiresAt?, lastRefreshAt?, lastError? } — tokens live ONLY in McpCredential.secret.
  auth            String?
  // §4.5 last capability snapshot: { serverInfo, declared, tools, resources, resourceTemplates, prompts, capturedAt, notes? }
  capabilities    String?
}

// Credentials are SERVER-SIDE ONLY. The secret JSON is never returned by any
// API route (responses carry `hasCredentials` + field names only), never
// logged and never written into tool definitions or exports.
model McpCredential {
  connectorId String   @id
  connector   McpConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  type        String // oauth | access_token | api_token | api_key (per provider registry)
  secret      String // JSON — field values from the provider's credential schema
  updatedAt   DateTime @updatedAt
}
