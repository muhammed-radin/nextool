{
  "version": 1,
  "providers": [
    {
      "id": "gmail",
      "name": "Gmail",
      "description": "Gmail MCP server — read, draft, send and search email via the Gmail API through a Model Context Protocol server.",
      "category": "google-workspace",
      "docsUrl": "https://github.com/GongRzhe/Gmail-MCP-Server",
      "enabled": true,
      "transport": {
        "type": "stdio",
        "defaultCommand": "npx",
        "defaultArgs": [
          "-y",
          "@gongrzhe/server-gmail-autoauth-mcp"
        ],
        "configFields": [
          {
            "key": "command",
            "label": "Command",
            "type": "string",
            "required": false,
            "placeholder": "npx",
            "description": "Executable that starts the MCP server (default from the provider definition)."
          },
          {
            "key": "args",
            "label": "Arguments",
            "type": "string",
            "required": false,
            "placeholder": "-y @gongrzhe/server-gmail-autoauth-mcp",
            "description": "Space-separated command arguments (default from the provider definition)."
          }
        ]
      },
      "authentication": {
        "type": "oauth",
        "title": "Google OAuth credentials",
        "description": "The server is launched with your Google Cloud OAuth client (Desktop app). Credentials are injected as environment variables — they are stored server-side only and never leave the NexTool process.",
        "injection": "env",
        "requiredFields": [
          "clientId",
          "clientSecret"
        ],
        "optionalFields": [
          "refreshToken",
          "accessToken"
        ],
        "fields": [
          {
            "key": "clientId",
            "label": "OAuth Client ID",
            "type": "string",
            "required": true,
            "secret": true,
            "placeholder": "xxxxxxxx.apps.googleusercontent.com",
            "description": "Google Cloud OAuth 2.0 Client ID (Desktop app type).",
            "envName": "GOOGLE_CLIENT_ID"
          },
          {
            "key": "clientSecret",
            "label": "OAuth Client Secret",
            "type": "string",
            "required": true,
            "secret": true,
            "placeholder": "GOCSPX-…",
            "description": "Google Cloud OAuth 2.0 Client Secret.",
            "envName": "GOOGLE_CLIENT_SECRET"
          },
          {
            "key": "refreshToken",
            "label": "Refresh Token",
            "type": "string",
            "required": false,
            "secret": true,
            "description": "Optional pre-authorized refresh token for headless setups.",
            "envName": "GOOGLE_REFRESH_TOKEN"
          },
          {
            "key": "accessToken",
            "label": "Access Token",
            "type": "string",
            "required": false,
            "secret": true,
            "description": "Optional short-lived access token (refresh token preferred).",
            "envName": "GOOGLE_ACCESS_TOKEN"
          }
        ]
      }
    },
    {
