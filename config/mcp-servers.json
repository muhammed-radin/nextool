            "label": "Command",
            "type": "string",
            "required": false,
            "placeholder": "npx",
            "description": "Executable that starts the MCP server (default from the provider definition)."
          },
          {
            "key": "args",
            "label": "Arguments",
            "type": "string",
            "required": false,
            "placeholder": "-y @cocal/google-calendar-mcp",
            "description": "Space-separated command arguments (default from the provider definition)."
