        ]
      }
    },
    {
      "id": "github",
      "name": "GitHub",
      "description": "GitHub MCP server — repositories, issues, pull requests and files via the official GitHub MCP server (remote Streamable HTTP or local stdio).",
      "category": "developer-tools",
      "docsUrl": "https://github.com/github/github-mcp-server",
      "enabled": true,
      "transport": {
        "type": "http",
        "defaultUrl": "https://api.githubcopilot.com/mcp/",
        "configFields": [
          {
            "key": "url",
            "label": "Server URL",
            "type": "string",
            "required": false,
            "placeholder": "https://api.githubcopilot.com/mcp/",
            "description": "Streamable HTTP endpoint of the MCP server (default from the provider definition)."
          },
          {
            "key": "command",
            "label": "Local command (optional stdio)",
            "type": "string",
            "required": false,
            "placeholder": "docker",
            "description": "When set, the connector uses the stdio transport with this command instead of the remote HTTP endpoint."
          },
          {
            "key": "args",
            "label": "Local arguments",
            "type": "string",
            "required": false,
            "placeholder": "run -i --rm ghcr.io/github/github-mcp-server",
            "description": "Arguments for the optional stdio mode."
          }
        ]
      },
      "authentication": {
        "type": "api_token",
        "title": "GitHub personal access token",
        "description": "A fine-grained or classic PAT is sent as a Bearer token. It is stored server-side only and used exclusively inside the NexTool process to authenticate with the MCP server.",
        "injection": "header",
        "headerName": "Authorization",
        "headerTemplate": "Bearer ${token}",
        "requiredFields": [
          "token"
        ],
        "optionalFields": [],
        "fields": [
          {
            "key": "token",
            "label": "Personal Access Token",
            "type": "string",
            "required": true,
            "secret": true,
            "placeholder": "github_pat_… / ghp_…",
            "description": "GitHub PAT with the scopes the MCP server requires (e.g. repo, read:org)."
          }
        ]
      }
    }
  ]
}
