# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# v1.0.91 FIX: these were bare "test"/"prompt" patterns which matched ANY path
# named test — including src/app/api/tools/test/route.ts. That is exactly why
# the POST /api/tools/test route silently vanished from git and every backup
# (the recurring HTTP 405 root cause). Anchored to the repo root instead.
/test/
/prompt/

server.log
# Skills directory
/skills/

# local runtime databases (models/datasets/tools live data are portable-exported via exports/)
db/*.db
db/*.sqlite
db/*.sqlite3

# internal agent/automation artifacts
worklog.md
tool-results/
.zscripts/dev.pid

# temporary virtual FS / runtime temp files
.vfs-tmp/
*.tmp
upload/
tool-results/
agent-ctx/
