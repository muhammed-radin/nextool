        "title": "Google account access",
        "description": "Choose how NexTool authenticates with Google for Calendar: paste an access + refresh token pair, or log in through NexTool's OAuth redirect flow. Tokens are stored server-side only.",
        "injection": "env",
        "authMethods": ["token_pair", "oauth2", "bearer"],
        "requiredFieldsByMethod": {
