            "description": "Refresh token (auto-refreshes the access token when it expires).",
            "envName": "GOOGLE_CALENDAR_REFRESH_TOKEN"
          },
          {
            "key": "accessToken",
            "label": "Access Token",
            "type": "string",
            "required": false,
            "secret": true,
            "description": "Access token for the Google API scopes you selected.",
            "envName": "GOOGLE_CALENDAR_ACCESS_TOKEN"
          }
        ]
      }
    },
    {
      "id": "google-drive",
      "name": "Google Drive",
      "description": "Google Drive MCP server — search, read, list and export Drive files through a Model Context Protocol server.",
      "category": "google-workspace",
      "docsUrl": "https://github.com/nsttt/google-drive-mcp",
      "enabled": true,
      "transport": {
        "type": "stdio",
        "defaultCommand": "npx",
        "defaultArgs": [
          "-y",
          "@nsttt/google-drive-mcp"
        ],
        "configFields": [
          {
            "key": "command",
            "label": "Command",
            "type": "string",
            "required": false,
            "placeholder": "npx",
            "description": "Executable that starts the MCP server (default from the provider definition)."
          },
          {
            "key": "args",
            "label": "Arguments",
            "type": "string",
            "required": false,
            "placeholder": "-y @nsttt/google-drive-mcp",
            "description": "Space-separated command arguments (default from the provider definition)."
          }
        ]
      },
      "authentication": {
        "type": "oauth",
        "title": "Google account access",
        "description": "Choose how NexTool authenticates with Google for Drive: paste an access + refresh token pair, or log in through NexTool's OAuth redirect flow. Tokens are stored server-side only.",
        "injection": "env",
        "authMethods": ["token_pair", "oauth2", "bearer"],
        "requiredFieldsByMethod": {
          "token_pair": ["accessToken"],
          "oauth2": [],
          "bearer": ["accessToken"]
        },
        "oauth": {
          "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
          "tokenUrl": "https://oauth2.googleapis.com/token",
          "defaultScopes": [
            "https://www.googleapis.com/auth/drive.readonly",
            "https://www.googleapis.com/auth/drive.file"
          ],
          "scopeSeparator": " ",
          "pkce": true,
          "tokenStyle": "form",
          "accessTokenField": "accessToken",
          "refreshTokenField": "refreshToken"
        },
        "loginWording": "Login via Google",
        "validation": "google_tokeninfo",
        "requiredFields": ["clientId", "clientSecret"],
        "optionalFields": ["refreshToken", "accessToken"],
        "fields": [
          {
            "key": "clientId",
            "label": "OAuth Client ID",
            "type": "string",
            "required": true,
            "secret": true,
            "placeholder": "xxxxxxxx.apps.googleusercontent.com",
            "description": "Google Cloud OAuth 2.0 Client ID.",
            "envName": "GOOGLE_DRIVE_CLIENT_ID"
          },
          {
            "key": "clientSecret",
            "label": "OAuth Client Secret",
            "type": "string",
            "required": true,
            "secret": true,
            "placeholder": "GOCSPX-…",
            "description": "Google Cloud OAuth 2.0 Client Secret.",
            "envName": "GOOGLE_DRIVE_CLIENT_SECRET"
          },
          {
            "key": "refreshToken",
            "label": "Refresh Token",
            "type": "string",
            "required": false,
            "secret": true,
            "description": "Refresh token (auto-refreshes the access token when it expires).",
            "envName": "GOOGLE_DRIVE_REFRESH_TOKEN"
          },
          {
            "key": "accessToken",
            "label": "Access Token",
            "type": "string",
            "required": false,
            "secret": true,
            "description": "Access token for the Google API scopes you selected.",
            "envName": "GOOGLE_DRIVE_ACCESS_TOKEN"
          }
        ]
      }
    },
    {
      "id": "github",
      "name": "GitHub",
      "description": "GitHub MCP server — repositories, issues, pull requests and files via the official GitHub MCP server (remote Streamable HTTP or local stdio).",
      "category": "developer-tools",
      "docsUrl": "https://github.com/github/github-mcp-server",
      "enabled": true,
      "transport": {
        "type": "http",
        "defaultUrl": "https://api.githubcopilot.com/mcp/",
        "configFields": [
          {
            "key": "url",
            "label": "Server URL",
            "type": "string",
            "required": false,
            "placeholder": "https://api.githubcopilot.com/mcp/",
            "description": "Streamable HTTP endpoint of the MCP server (default from the provider definition)."
          }
        ]
      },
      "authentication": {
        "type": "api_token",
        "title": "GitHub access",
        "description": "Authenticate with a personal access token you already have, or log in through NexTool's GitHub OAuth redirect flow. The token is sent as a Bearer header and stored server-side only.",
        "injection": "header",
        "headerName": "Authorization",
        "headerTemplate": "Bearer ${token}",
        "authMethods": ["bearer", "oauth2"],
        "requiredFieldsByMethod": {
          "bearer": ["token"],
          "oauth2": []
        },
        "oauth": {
          "authorizeUrl": "https://github.com/login/oauth/authorize",
          "tokenUrl": "https://github.com/login/oauth/access_token",
          "defaultScopes": ["repo", "read:user"],
          "scopeSeparator": " ",
          "pkce": false,
          "tokenStyle": "form",
          "accessTokenField": "token"
        },
        "loginWording": "Login via GitHub",
        "validation": "github_user",
        "requiredFields": ["token"],
        "optionalFields": [],
        "fields": [
          {
            "key": "token",
            "label": "Personal Access Token",
            "type": "string",
            "required": true,
            "secret": true,
            "placeholder": "github_pat_… / ghp_…",
            "description": "GitHub PAT (or OAuth user token from the redirect login) with the scopes the MCP server requires."
          }
        ]
      }
    },
    {
      "id": "custom",
      "name": "Custom MCP",
      "description": "Any Model Context Protocol server — connect over a URL (Streamable HTTP / SSE) or launch a local command (stdio). Everything is manual: transport, credentials, and (optionally) custom OAuth endpoints.",
      "category": "general",
      "enabled": true,
      "transport": {
        "type": "http",
        "configFields": []
      },
      "authentication": {
        "type": "access_token",
        "title": "Custom authentication",
        "description": "Everything is manual: no auth, a bearer/access token, an access + refresh token pair, or a fully custom OAuth 2.0 authorization-code flow with your own endpoints.",
        "injection": "header",
        "headerName": "Authorization",
        "headerTemplate": "Bearer ${accessToken}",
        "authMethods": ["none", "bearer", "token_pair", "oauth2"],
        "requiredFieldsByMethod": {
          "none": [],
          "bearer": ["accessToken"],
          "token_pair": ["accessToken"],
          "oauth2": []
        },
        "oauth": {
          "defaultScopes": [],
          "scopeSeparator": " ",
          "pkce": true,
          "tokenStyle": "form",
          "accessTokenField": "accessToken",
          "refreshTokenField": "refreshToken"
        },
        "loginWording": "Login via NexTool redirect",
        "requiredFields": [],
        "optionalFields": ["accessToken", "refreshToken"],
        "fields": [
          {
            "key": "accessToken",
            "label": "Access Token",
            "type": "string",
            "required": false,
            "secret": true,
            "placeholder": "paste the access token",
            "description": "Sent as the Authorization: Bearer header on every request (URL mode) — for command mode pass tokens through env vars instead."
          },
          {
            "key": "refreshToken",
            "label": "Refresh Token",
            "type": "string",
            "required": false,
            "secret": true,
            "description": "Optional refresh token — auto-refreshes the access token when a custom token endpoint is configured."
          }
        ]
      }
    }
  ]
}
