{
  "version": 2,
  "providers": [
    {
      "id": "gmail",
      "name": "Gmail",
      "description": "Gmail MCP server — read, draft, send and search email via the Gmail API through a Model Context Protocol server.",
      "category": "google-workspace",
      "docsUrl": "https://github.com/GongRzhe/Gmail-MCP-Server",
      "enabled": true,
      "transport": {
        "type": "stdio",
        "defaultCommand": "npx",
        "defaultArgs": [
          "-y",
          "@gongrzhe/server-gmail-autoauth-mcp"
        ],
        "configFields": [
          {
            "key": "command",
            "label": "Command",
            "type": "string",
            "required": false,
            "placeholder": "npx",
            "description": "Executable that starts the MCP server (default from the provider definition)."
          },
          {
            "key": "args",
            "label": "Arguments",
            "type": "string",
            "required": false,
            "placeholder": "-y @gongrzhe/server-gmail-autoauth-mcp",
            "description": "Space-separated command arguments (default from the provider definition)."
          }
        ]
      },
      "authentication": {
        "type": "oauth",
        "title": "Google account access",
        "description": "Choose how NexTool authenticates with Google: paste an access + refresh token pair you already obtained, or log in through NexTool's OAuth redirect flow. Tokens are stored server-side only.",
        "injection": "env",
        "authMethods": ["token_pair", "oauth2", "bearer"],
        "requiredFieldsByMethod": {
          "token_pair": ["accessToken"],
          "oauth2": [],
          "bearer": ["accessToken"]
        },
        "oauth": {
          "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
          "tokenUrl": "https://oauth2.googleapis.com/token",
          "defaultScopes": [
            "https://www.googleapis.com/auth/gmail.readonly",
            "https://www.googleapis.com/auth/gmail.send",
            "https://www.googleapis.com/auth/gmail.compose",
            "https://www.googleapis.com/auth/gmail.modify"
          ],
          "scopeSeparator": " ",
          "pkce": true,
          "tokenStyle": "form",
          "accessTokenField": "accessToken",
          "refreshTokenField": "refreshToken"
        },
        "loginWording": "Login via Google",
        "validation": "google_tokeninfo",
        "requiredFields": ["clientId", "clientSecret"],
        "optionalFields": ["refreshToken", "accessToken"],
        "fields": [
          {
            "key": "clientId",
            "label": "OAuth Client ID",
            "type": "string",
            "required": true,
            "secret": true,
            "placeholder": "xxxxxxxx.apps.googleusercontent.com",
            "description": "Google Cloud OAuth 2.0 Client ID (Desktop or Web application type).",
            "envName": "GOOGLE_CLIENT_ID"
          },
          {
            "key": "clientSecret",
            "label": "OAuth Client Secret",
            "type": "string",
            "required": true,
            "secret": true,
            "placeholder": "GOCSPX-…",
            "description": "Google Cloud OAuth 2.0 Client Secret.",
            "envName": "GOOGLE_CLIENT_SECRET"
          },
          {
            "key": "refreshToken",
            "label": "Refresh Token",
            "type": "string",
            "required": false,
            "secret": true,
            "description": "Refresh token (auto-refreshes the access token when it expires).",
            "envName": "GOOGLE_REFRESH_TOKEN"
          },
          {
            "key": "accessToken",
            "label": "Access Token",
            "type": "string",
            "required": false,
            "secret": true,
            "description": "Access token for the Google API scopes you selected.",
            "envName": "GOOGLE_ACCESS_TOKEN"
          }
        ]
      }
    },
    {
      "id": "google-calendar",
